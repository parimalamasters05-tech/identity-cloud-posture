# Copy to .env and fill in. .env is gitignored; never commit it.
#
#   cp .env.example .env
#
# Nothing in this file is read automatically -- the tool reads the environment.
# Load it with `set -a; source .env; set +a` or use direnv.

# --- Tenant identification ---------------------------------------------------

# Short identifier for this engagement. Used in snapshot and report filenames,
# so keep it filesystem-safe: letters, digits, hyphens.
ICP_TENANT_ID=riverside-trust

# A super-administrator in the client tenant. The service account impersonates
# this account via domain-wide delegation. It is never used to sign in.
ICP_GOOGLE_ADMIN_SUBJECT=admin@clientdomain.example

# The client's primary domain, as it appears in the Admin console.
ICP_GOOGLE_PRIMARY_DOMAIN=clientdomain.example

# Leave as my_customer to target the tenant of the impersonated admin.
ICP_GOOGLE_CUSTOMER_ID=my_customer

# --- Credentials -------------------------------------------------------------
#
# Preferred: Application Default Credentials or Workload Identity Federation,
# which involve no long-lived key material at all.
#
# Otherwise, point at a service-account key file. It MUST be chmod 600; the tool
# refuses to read a key file that other users can read.
ICP_GOOGLE_KEY_FILE=/absolute/path/to/service-account.json

# For CI, supply the key as JSON in an environment variable instead, so it never
# touches disk. Takes precedence over ICP_GOOGLE_KEY_FILE.
# ICP_GOOGLE_SA_KEY_JSON={"type":"service_account", ...}

# --- Data handling -----------------------------------------------------------

# Snapshot encryption key, base64 of 32 bytes. Generate with: icp keygen
# Store it in a secret manager. Losing it makes existing snapshots unreadable.
ICP_SNAPSHOT_KEY=

# Encryption at rest. Live collection refuses to write plaintext (this set to
# false, or --no-encrypt) unless ICP_TEST_ENVIRONMENT=true -- your own
# deliberately misconfigured test tenant, never a client. Reports from a test
# environment say so on the cover.
ICP_ENCRYPT_AT_REST=true
# ICP_TEST_ENVIRONMENT=false

# Days before `icp purge` destroys snapshots. Must match what the engagement
# letter and data handling policy promise the client.
ICP_RETENTION_DAYS=30

# The other kinds of file `icp purge` deletes, each on its own period (data
# handling policy, section 4). Reports are kept until you set theirs.
# ICP_FINDINGS_RETENTION_DAYS=30
# ICP_AUDIT_TRAIL_RETENTION_DAYS=365
# ICP_REPORT_RETENTION_DAYS=

# Days after collection before `report` needs --allow-stale for a snapshot.
# ICP_MAX_SNAPSHOT_AGE_DAYS=7

# Recorded in the deletion attestation.
ICP_OPERATOR=

# --- Paths (defaults are fine) -----------------------------------------------
#
# One engagement per working copy, or give each its own snapshot and output
# directories and its own ICP_SNAPSHOT_KEY. `report` refuses a snapshot whose
# Google domain, Microsoft tenant or AWS account differs from this file's.

# ICP_SNAPSHOT_DIR=snapshots
# ICP_OUTPUT_DIR=output
# ICP_CONFIG_DIR=config
# ICP_FIXTURE_DIR=fixtures

# --- Tuning (defaults are fine) ----------------------------------------------

# ICP_MAX_PAGE_SIZE=200
# ICP_REQUEST_TIMEOUT=60
# ICP_MAX_RETRIES=5

# --- Docker only -------------------------------------------------------------
#
# Path ON YOUR HOST to the service-account key. docker-compose mounts it
# read-only at /run/secrets/sa-key.json; it is never copied into the image.
ICP_HOST_KEY_FILE=/absolute/path/to/service-account.json

# The assessor printed on the report cover: you, or your company.
# The client's name is NOT set here. It is read from their Google Workspace
# account profile (scope admin.directory.customer.readonly), falling back to
# their primary domain. Override a single run with `report --client-name "..."`.
ICP_ASSESSOR=Your Name

# Note: the container runs as UID 10001. Bind-mounted directories must be
# writable by it:
#     mkdir -p snapshots output && sudo chown -R 10001:10001 snapshots output
# Not needed on Docker Desktop for macOS or Windows.

# -- Microsoft 365 (week 5) ----------------------------------------------------
# App registration "ICP Assessment (read-only)", certificate sign-in. The
# private key stays outside the repository.
ICP_M365_TENANT_ID=
ICP_M365_CLIENT_ID=
ICP_M365_CERT_THUMBPRINT=
ICP_HOST_M365_KEY_FILE=
# ICP_M365_TENANT_LABEL=m365

# -- AWS (week 5, read by Prowler) ---------------------------------------------
# Access key of a user whose only right is sts:AssumeRole on the role below.
# Only these three reach the Prowler container.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Role with SecurityAudit + ViewOnlyAccess only, and its external ID.
ICP_AWS_ROLE_ARN=
ICP_AWS_EXTERNAL_ID=
# ICP_AWS_TENANT_LABEL=aws
